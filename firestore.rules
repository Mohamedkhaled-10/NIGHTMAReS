rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isActiveUser() {
      return isAuthenticated() && (getUserData().accountStatus == 'active' || getUserData().accountStatus == 'pending_verification');
    }

    // Users Collection
    match /users/{uid} {
      allow read: if true; // Public profiles (for comments)
      allow create: if isOwner(uid) 
                    && request.resource.data.role == 'user'
                    && request.resource.data.accountStatus in ['active', 'pending_verification'];
      allow update: if (isOwner(uid) 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'lastLoginAt', 'emailVerified']))
                    || isAdmin();
      allow delete: if isAdmin(); // Soft delete preferred, but allow admin delete
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable
    }

    // User Submissions Collection
    match /user_submissions/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if true; // Any visitor can submit a story
      allow update: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid && resource.data.status == 'needs_edit' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName', 'title', 'category', 'content', 'status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // User Bookmarks
    match /user_bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User History
    match /user_history/{historyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || resource.data.userId == 'all');
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || resource.data.userId == 'all') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy']);
      allow create: if isAuthenticated();
    }
    
    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.authorUid == request.auth.uid;
      allow update: if (isActiveUser() && resource.data.authorUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'status']))
                    || isAdmin();
      allow delete: if isAdmin() || (isActiveUser() && resource.data.authorUid == request.auth.uid);
    }
    
    // Reports Collection (Comments, Content, Users)
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isActiveUser() && request.resource.data.reporterUid == request.auth.uid;
    }

    // Content Likes Collection (Document ID: {contentId}_{userUid})
    match /content_likes/{likeId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.userUid == request.auth.uid;
      allow delete: if isActiveUser() && resource.data.userUid == request.auth.uid;
    }

    // Content Stats (Aggregated like counts)
    match /content_stats/{contentId} {
      allow read: if true;
      allow create, update: if true; // Allow client increment for views, likes, comments
    }
    // Posts Collection
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likesCount', 'commentsCount'])
      );
    }

    // System Collection
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads Templates Collection
    match /ads_templates/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
