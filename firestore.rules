rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isActiveUser() {
      return isAuthenticated() && (getUserData().accountStatus == 'active' || getUserData().accountStatus == 'pending_verification');
    }

    // Users Collection
    match /users/{uid} {
      allow read: if true; // Public profiles (for comments)
      allow create: if isOwner(uid) 
                    && request.resource.data.role == 'user'
                    && request.resource.data.accountStatus in ['active', 'pending_verification'];
      allow update: if (isOwner(uid) 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'lastLoginAt', 'emailVerified']))
                    || isAdmin();
      allow delete: if isAdmin(); // Soft delete preferred, but allow admin delete
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.authorUid == request.auth.uid;
      allow update: if (isActiveUser() && resource.data.authorUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'status']))
                    || isAdmin();
      allow delete: if isAdmin() || (isActiveUser() && resource.data.authorUid == request.auth.uid);
    }
    
    // Comment Reports
    match /comment_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isActiveUser() && request.resource.data.reporterUid == request.auth.uid;
    }

    // Content Likes Collection (Document ID: {contentId}_{userUid})
    match /content_likes/{likeId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.userUid == request.auth.uid;
      allow delete: if isActiveUser() && resource.data.userUid == request.auth.uid;
    }

    // Content Stats (Aggregated like counts)
    match /content_stats/{contentId} {
      allow read: if true;
      allow create: if isActiveUser();
      allow update: if isActiveUser(); // In a real production app, use Cloud Functions to aggregate, but for now allow client increment
    }
    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // System Collection
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads Templates Collection
    match /ads_templates/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
